{
  "expo": {
    "name": "FlowMate AI",
    "slug": "flowmate-ai",
    "scheme": "flowmateai",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#55BEFE"
      },
      "package": "com.anonymous.flowmateai"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
